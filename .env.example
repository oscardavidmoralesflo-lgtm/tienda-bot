# Copia este archivo como ".env" y rellena los valores. NUNCA compartas el .env.

# Token de TU bot (créalo en Telegram con @BotFather → /newbot)
BOT_TOKEN=

# Token de la API de KOKORO (en @Shop_KOKORO_BOT → 🔗 API LINK → Generate token)
KOKORO_API_TOKEN=

# Tu ID numérico de Telegram (pídelo a @userinfobot). Varios admins separados por coma.
ADMIN_IDS=

# Contraseña para entrar al panel web /admin (usa una larga)
ADMIN_PASSWORD=

# Prefijo único para tus pedidos en KOKORO (solo letras y números)
SHOP_PREFIX=mitienda

# Base de datos PostgreSQL (Supabase). Vacío = base local en ./data (solo para probar en tu PC)
DATABASE_URL=
# Si compartes un proyecto de Supabase con otra app, las tablas del bot van en este esquema aparte
DB_SCHEMA=tienda

# URL pública del servidor. En Render se detecta sola; vacío en tu PC (usa modo polling)
PUBLIC_URL=
